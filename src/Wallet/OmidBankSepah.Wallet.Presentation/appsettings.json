{
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "Ssl": false,
    "ConnectionName": "Wallet Service Local",
    "DispatchConsumersAsync": true,
    "AutomaticRecoveryEnabled": true,
    "PrefetchCount": 5,
    "RetryConnectionIntervalInSecond": 2,
    "MaxRetry": 5,
    "ProductInventoryQueue": "Wallet.ProductInventory",
    "SubscribingQueues": {
      "Wallet.ProductInventory": {
        "Exchange": "ProductInventory",
        "AutoAck": false,
        "IsBinding": true,
        "ServiceName": "Wallet"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
