{
  "info": {
    "_postman_id": "62d9df0a-3717-4af0-9d69-11ff810e461f",
    "name": "OmidBankSepah - Order and Product Availability",
    "description": "مجموعه آزمون جریان سفارش و موجودی بر اساس سناریوهای پروژه.\n\nپیش‌نیاز اجرا:\n1. Migrationهای Order و MasterData اجرا شده باشند؛ SQL Server و Redis فعال باشند.\n2. سرویس MasterData gRPC روی پورت 5085 و APIهای HTTP روی 5154 و 5086 اجرا باشند.\n3. متغیر collection با نام productId را با شناسه GUID یک محصول موجود در MasterData جایگزین کنید؛ API ساخت محصول در این پروژه وجود ندارد.\n4. پوشه‌های 01 تا 05 را به ترتیب اجرا کنید. پوشه 06 و درخواست پوشه 07 آزمون‌های دستی هستند.\n\nمسیرهای پوشش‌داده‌شده: افزایش و مشاهده موجودی، سفارش تأییدشده و کسر موجودی، سفارش چندآیتمی با شکست اتمیک، آیتم تکراری، idempotency و retry، ورودی نامعتبر، شناسه/محصول ناموجود، بازیابی پس از قطع gRPC و درخواست همزمان.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "orderBaseUrl",
      "value": "http://localhost:5086"
    },
    {
      "key": "masterDataBaseUrl",
      "value": "http://localhost:5154"
    },
    {
      "key": "productId",
      "value": "11111111-1111-4111-8111-111111111111",
      "description": "حتماً با GUID یک محصول موجود در پایگاه داده MasterData جایگزین شود."
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "unavailableProductId",
      "value": ""
    },
    {
      "key": "missingOrderId",
      "value": ""
    },
    {
      "key": "seedQuantity",
      "value": "20"
    },
    {
      "key": "confirmedOrderQuantity",
      "value": "2"
    },
    {
      "key": "duplicateLineQuantityOne",
      "value": "1"
    },
    {
      "key": "duplicateLineQuantityTwo",
      "value": "2"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('customerId')) pm.collectionVariables.set('customerId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('unavailableProductId')) pm.collectionVariables.set('unavailableProductId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('missingOrderId')) pm.collectionVariables.set('missingOrderId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - آماده‌سازی و افزایش موجودی",
      "description": "ابتدا موجودی فعلی محصول موجود را می‌خواند، سپس آن را افزایش می‌دهد و مقدار نهایی را بررسی می‌کند.",
      "item": [
        {
          "name": "01 - موجودی قبل از افزایش",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('موجودی با HTTP 200 خوانده می‌شود', function () { pm.response.to.have.status(200); });",
                  "const raw = pm.response.text().trim();",
                  "const body = raw && raw !== 'null' ? JSON.parse(raw) : null;",
                  "const quantity = body ? (body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity) : 0;",
                  "pm.collectionVariables.set('initialInventory', String(Number(quantity)));",
                  "pm.test('موجودی اولیه صفر یا بیشتر است', function () { pm.expect(Number(quantity)).to.be.at.least(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - افزایش موجودی",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": {{seedQuantity}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}/increase"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('افزایش موجودی با HTTP 200 انجام می‌شود', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "const expected = Number(pm.collectionVariables.get('initialInventory')) + Number(pm.collectionVariables.get('seedQuantity'));",
                  "pm.test('مقدار موجودی به اندازه درخواست افزایش یافته است', function () { pm.expect(actual).to.eql(expected); });",
                  "pm.collectionVariables.set('seededInventory', String(actual));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - مشاهده موجودی افزایش‌یافته",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "pm.test('موجودی خوانده‌شده با نتیجه افزایش برابر است', function () { pm.expect(actual).to.eql(Number(pm.collectionVariables.get('seededInventory'))); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - سفارش موفق و Idempotency",
      "description": "ثبت سفارش تأییدشده، مشاهده جزئیات، کنترل کسر موجودی، retry با همان کلید و رد استفاده از همان کلید برای محتوای متفاوت.",
      "item": [
        {
          "name": "01 - ایجاد سفارش قابل تأیید",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('successIdempotencyKey', 'postman-success-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('وضعیت سفارش Confirmed است', function () { pm.expect([1, 'Confirmed']).to.include(status); });",
                  "pm.collectionVariables.set('successOrderId', body.id || body.Id);",
                  "pm.collectionVariables.set('inventoryAfterSuccess', String(Number(pm.collectionVariables.get('seededInventory')) - Number(pm.collectionVariables.get('confirmedOrderQuantity'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{successIdempotencyKey}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"price\": 125000,\n      \"quantity\": {{confirmedOrderQuantity}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "02 - مشاهده جزئیات سفارش تأییدشده",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderBaseUrl}}/api/orders/{{successOrderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.test('شناسه سفارش با پاسخ ایجاد برابر است', function () { pm.expect(body.id || body.Id).to.eql(pm.collectionVariables.get('successOrderId')); });",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('وضعیت نهایی سفارش Confirmed است', function () { pm.expect([1, 'Confirmed']).to.include(status); });",
                  "pm.test('جزئیات آیتم و مبلغ موجود است', function () { pm.expect(body.items || body.Items).to.have.lengthOf(1); pm.expect(Number(body.totalAmount !== undefined ? body.totalAmount : body.TotalAmount)).to.eql(125000 * Number(pm.collectionVariables.get('confirmedOrderQuantity'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - موجودی پس از رزرو موفق",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "pm.test('موجودی دقیقاً به تعداد سفارش کاهش یافته است', function () { pm.expect(actual).to.eql(Number(pm.collectionVariables.get('inventoryAfterSuccess'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Retry همان سفارش با همان کلید",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{successIdempotencyKey}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"price\": 125000,\n      \"quantity\": {{confirmedOrderQuantity}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.test('Retry همان سفارش قبلی را برمی‌گرداند', function () { pm.expect(body.id || body.Id).to.eql(pm.collectionVariables.get('successOrderId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - کنترل عدم کسر دوباره موجودی در Retry",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "pm.test('Retry موجودی را دوباره کاهش نداده است', function () { pm.expect(actual).to.eql(Number(pm.collectionVariables.get('inventoryAfterSuccess'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - استفاده از کلید قبلی با درخواست متفاوت",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{successIdempotencyKey}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"price\": 125000,\n      \"quantity\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('درخواست متفاوت با همان کلید رد می‌شود', function () { pm.response.to.have.status(400); });",
                  "const body = pm.response.json();",
                  "pm.test('خطا با envelope استاندارد برمی‌گردد', function () { pm.expect(body.isSuccess === false || body.IsSuccess === false).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - چند آیتم و تجمیع محصول تکراری",
      "description": "دو ردیف با ProductId یکسان باید جمع شوند و فقط مجموع تعداد از موجودی کم شود.",
      "item": [
        {
          "name": "01 - ثبت موجودی قبل از سفارش چندردیفی",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('duplicateOrderInventoryBefore', String(Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity)));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - سفارش با دو ردیف از یک محصول",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('duplicateIdempotencyKey', 'postman-duplicate-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('سفارش چندردیفی تأیید می‌شود', function () { pm.expect([1, 'Confirmed']).to.include(status); });",
                  "pm.test('هر دو ردیف در جزئیات سفارش حفظ شده‌اند', function () { pm.expect(body.items || body.Items).to.have.lengthOf(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{duplicateIdempotencyKey}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"price\": 100, \"quantity\": {{duplicateLineQuantityOne}} },\n    { \"productId\": \"{{productId}}\", \"price\": 150, \"quantity\": {{duplicateLineQuantityTwo}} }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "03 - کنترل کسر مجموع دو ردیف",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "const expected = Number(pm.collectionVariables.get('duplicateOrderInventoryBefore')) - Number(pm.collectionVariables.get('duplicateLineQuantityOne')) - Number(pm.collectionVariables.get('duplicateLineQuantityTwo'));",
                  "pm.test('فقط مجموع تعداد دو ردیف کسر شده است', function () { pm.expect(actual).to.eql(expected); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - رد سفارش و رزرو اتمیک",
      "description": "یک محصول موجود و یک محصول بدون موجودی سفارش داده می‌شوند؛ سفارش باید رد شود و موجودی محصول موجود دست‌نخورده بماند.",
      "item": [
        {
          "name": "01 - موجودی قبل از سفارش ناکافی",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('atomicInventoryBefore', String(Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity)));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - سفارش با یک قلم ناموجود",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('rejectedIdempotencyKey', 'postman-rejected-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('وجود یک قلم ناموجود کل سفارش را Rejected می‌کند', function () { pm.expect([2, 'Rejected']).to.include(status); });",
                  "pm.test('دلیل رد سفارش برگشت داده شده است', function () { pm.expect(body.rejectionReason || body.RejectionReason).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('rejectedOrderId', body.id || body.Id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{rejectedIdempotencyKey}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"price\": 100, \"quantity\": 1 },\n    { \"productId\": \"{{unavailableProductId}}\", \"price\": 200, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "03 - مشاهده جزئیات سفارش ردشده",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderBaseUrl}}/api/orders/{{rejectedOrderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('جزئیات سفارش و وضعیت Rejected قابل مشاهده است', function () { pm.expect(body.id || body.Id).to.eql(pm.collectionVariables.get('rejectedOrderId')); pm.expect([2, 'Rejected']).to.include(status); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - موجودی پس از رد سفارش",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{masterDataBaseUrl}}/api/product-availability/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const actual = Number(body.availableQuantity !== undefined ? body.availableQuantity : body.AvailableQuantity);",
                  "pm.test('در رزرو ناموفق هیچ موجودی‌ای کم نشده است', function () { pm.expect(actual).to.eql(Number(pm.collectionVariables.get('atomicInventoryBefore'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Retry سفارش ردشده",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{rejectedIdempotencyKey}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"price\": 100, \"quantity\": 1 },\n    { \"productId\": \"{{unavailableProductId}}\", \"price\": 200, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.test('Retry همان سفارش ردشده را برمی‌گرداند', function () { pm.expect(body.id || body.Id).to.eql(pm.collectionVariables.get('rejectedOrderId')); });",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('وضعیت سفارش در Retry تغییر نکرده است', function () { pm.expect([2, 'Rejected']).to.include(status); });"
                ]
              }
            }
          ]
        },
