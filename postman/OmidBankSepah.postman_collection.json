    {
      "name": "06 - دستی: بازیابی سفارش پس از قطعی gRPC",
      "description": "این پوشه را جداگانه اجرا کنید: ابتدا سرویس MasterData gRPC روی پورت 5085 را متوقف کنید و فقط درخواست اول را بفرستید؛ باید 503 بگیرید. سپس gRPC را بالا بیاورید و درخواست دوم را با همان idempotencyKey بفرستید؛ همان سفارش Pending باید ادامه پیدا کند و به Confirmed یا Rejected برسد. این پوشه را در اجرای کامل Collection انتخاب نکنید.",
      "item": [
        {
          "name": "01 - ایجاد سفارش هنگام قطعی gRPC",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('recoveryIdempotencyKey', 'postman-recovery-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('قطعی gRPC با HTTP 503 گزارش می‌شود', function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{recoveryIdempotencyKey}}\",\n  \"items\": [ { \"productId\": \"{{productId}}\", \"price\": 10, \"quantity\": 1 } ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          }
        },
        {
          "name": "02 - Retry پس از راه‌اندازی مجدد gRPC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"idempotencyKey\": \"{{recoveryIdempotencyKey}}\",\n  \"items\": [ { \"productId\": \"{{productId}}\", \"price\": 10, \"quantity\": 1 } ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{orderBaseUrl}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const status = body.status !== undefined ? body.status : body.Status;",
                  "pm.test('Retry سفارش را از Pending به نتیجه نهایی می‌رساند', function () { pm.expect([1, 2, 'Confirmed', 'Rejected']).to.include(status); });",
                  "pm.collectionVariables.set('recoveredOrderId', body.id || body.Id);"
                ]
              }
            }
          ]
        }
